---
import type { ChartConfig } from '../../charts/types';
import { chartRegistry } from '../../charts/registry';
import ScrollySection from './ScrollySection.astro';
import StickyVizColumn from './StickyVizColumn.astro';

interface RenderedSection {
  sectionId: string;
  chartId: string | null;
  arrangement: 'paired' | 'full';
  Content: any;
}

interface Props {
  sections: RenderedSection[];
}

const { sections } = Astro.props;

// Consecutive "paired" sections share one sticky chart column (that's what
// makes the scroll-driven chart swap feel continuous); a "full" section
// breaks that flow and stands on its own, full-width, with no sticky
// column of its own. Grouping preserves each section's original order.
type PairedGroup = { kind: 'paired'; sections: RenderedSection[] };
type FullGroup = { kind: 'full'; section: RenderedSection };
const groups: Array<PairedGroup | FullGroup> = [];

for (const section of sections) {
  if (section.arrangement === 'full') {
    groups.push({ kind: 'full', section });
    continue;
  }
  const last = groups[groups.length - 1];
  if (last?.kind === 'paired') {
    last.sections.push(section);
  } else {
    groups.push({ kind: 'paired', sections: [section] });
  }
}
---

{
  groups.map((group) => {
    if (group.kind === 'full') {
      const { section } = group;
      return (
        <section class="scrolly-step-full" id={section.sectionId}>
          <section.Content />
        </section>
      );
    }

    const seen = new Set<string>();
    const charts: ChartConfig[] = [];
    for (const section of group.sections) {
      if (!section.chartId || seen.has(section.chartId)) continue;
      const config = chartRegistry[section.chartId];
      if (config) {
        charts.push(config);
        seen.add(section.chartId);
      }
    }

    return (
      <div class="scrolly-layout">
        <div class="scrolly-narrative">
          {group.sections.map((section) => (
            <ScrollySection
              sectionId={section.sectionId}
              chartId={section.chartId}
              chartConfig={section.chartId ? (chartRegistry[section.chartId] ?? null) : null}
            >
              <section.Content />
            </ScrollySection>
          ))}
        </div>
        <StickyVizColumn charts={charts} />
      </div>
    );
  })
}
