---
import type { ChartConfig } from '../../charts/types';
import ChartMount from '../charts/ChartMount.astro';

interface Props {
  charts: ChartConfig[];
}

const { charts } = Astro.props;
---

<div class="sticky-viz">
  {charts.map((config, i) => <ChartMount config={config} active={i === 0} />)}
</div>

<script src="./scrollyObserver.client.ts"></script>
<script src="../charts/chartBootstrap.client.ts"></script>
