---
import { getLangFromUrl } from '../../i18n/utils';
import { ui } from '../../i18n/ui';
import GeneExplorer from './GeneExplorer';

const lang = getLangFromUrl(Astro.url);
// `ui[lang]` is the site's full flat string dictionary; it structurally
// satisfies GeneExplorerStrings (a subset of those same keys) now that the
// "gene-explorer.*" keys live in src/i18n/ui.ts alongside every other
// namespace, so it's passed straight through — same pattern used
// elsewhere for chart label maps built from this dictionary.
const strings = ui[lang];
---

<GeneExplorer client:visible lang={lang} strings={strings} />
