---
import type { ChartConfig } from '../../charts/types';
import { getSeriesLabel, getAxisLabel } from '../../charts/labels';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  config: ChartConfig;
  /**
   * "sticky" (default): one shared desktop column reused across every
   * section, shown/hidden via the scroll-driven `.viz-pane[hidden]`
   * mechanism (see scrollyObserver.client.ts). "inline": a per-section
   * mount used on mobile, where there is no shared sticky column — it is
   * always present in that section's own flow, never hidden/toggled.
   */
  variant?: 'sticky' | 'inline';
  /** Only meaningful for variant="sticky": whether this is the pane shown initially. */
  active?: boolean;
}

const { config, variant = 'sticky', active = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Escape "</" so the embedded JSON can never prematurely close this <script> tag.
const json = JSON.stringify(config).replace(/<\//g, '<\\/');

// Legend entries come from a chart's own `legendKeys` when it sets one;
// stacked-bar/grouped-bar charts fall back to their own series order for
// backward compatibility with configs written before `legendKeys` existed.
const legendKeys =
  config.legendKeys ??
  (config.type === 'stacked-bar' ? config.stackKeys : config.type === 'grouped-bar' ? config.groups : []);
const legendEntries = legendKeys.map((key) => ({
  key,
  label: getSeriesLabel(config.id, key, lang),
}));

// The alternative data table is specific to tabular (stacked-bar) charts —
// other chart types are either self-explanatory via visible text (the
// methodology diagram) or already expose their data through hover/focus
// plus a legend (the network graph).
const tableSeriesKeys = config.type === 'stacked-bar' ? config.stackKeys : [];
const yAxisLabel = getAxisLabel(config.id, lang);

const wrapperClass = variant === 'inline' ? 'viz-inline' : 'viz-pane';
---

<div class={wrapperClass} data-chart-id={config.id} hidden={variant === 'sticky' && !active}>
  <script type="application/json" data-chart-config set:html={json} />
  <div class="viz-canvas" data-chart-canvas></div>

  {
    legendEntries.length > 1 && (
      <ul class="viz-legend" role="list">
        {legendEntries.map((entry) => (
          <li class="swatch" style={`--legend-color: var(--series-${entry.key})`}>
            {entry.label}
          </li>
        ))}
      </ul>
    )
  }

  <p class="chart-source">{t('chart.source')}</p>

  {
    config.type === 'stacked-bar' && (
      <details class="viz-table-toggle">
        <summary>{yAxisLabel}</summary>
        <table>
          <thead>
            <tr>
              <th scope="col" />
              {legendEntries.map((entry) => (
                <th scope="col">{entry.label}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {config.categories.map((category) => (
              <tr>
                <th scope="row">{category}</th>
                {tableSeriesKeys.map((key) => {
                  const row = config.data.find((d) => d.category === category && d.key === key);
                  return <td>{row?.value.toLocaleString(lang) ?? '—'}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    )
  }
</div>
